{
  "name": "fb-birthday-gratulator",
  "description": "Facebook Auto Post Birthday Message",
  "version": "4.1.2",
  "author": "Tim Bernhard @GenieTim",
  "bin": {
    "fb-gratulate": "./bin/run.js"
  },
  "bugs": "https://github.com/GenieTim/fb-birthday-gratulator/issues",
  "dependencies": {
    "@oclif/core": "^5.1.8",
    "@oclif/plugin-help": "^7.0.4",
    "@oclif/plugin-version": "^3.0.5",
    "cli-ux": "^6.0.9",
    "croner": "^10.0.1",
    "launch-editor": "^2.14.2",
    "playwright": "^1.64.1",
    "playwright-addons": "Niek/playwright-addons#master"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "eslint-config-oclif": "^7.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "files": [
    "/bin",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json",
    "/src"
  ],
  "homepage": "https://github.com/GenieTim/fb-birthday-gratulator",
  "keywords": [
    "automation",
    "facebook",
    "birthday"
  ],
  "license": "GPL-3.0",
  "main": "src/index.js",
  "oclif": {
    "commands": "./src/commands",
    "bin": "fb-gratulate",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-version"
    ],
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ]
  },
  "repository": "GenieTim/fb-birthday-gratulator",
  "scripts": {
    "start": "node bin/daemon.js",
    "daemon": "node bin/daemon.js",
    "gratulate": "node bin/run.js congratulate",
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint .",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "yarn lint",
    "prepack": "npx oclif manifest && npx oclif readme",
    "test": "node --test test/*.test.js",
    "version": "npx oclif readme && git add README.md",
    "fix": "eslint --fix ."
  }
}
