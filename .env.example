# Facebook Credentials (Required if config.json is not mounted)
FB_USERNAME=your-facebook-email@example.com
FB_PASSWORD=your-facebook-password

# Cron Schedule (Optional)
# If using Coolify's native Scheduled Tasks tab (recommended), leave this empty!
# If running standalone Docker without Coolify Scheduled Tasks, set to e.g. 0 9 * * *
CRON_SCHEDULE=

# Timezone (e.g. Europe/Zurich, UTC, America/New_York)
TZ=Europe/Zurich

# Run immediately once when container starts up (true / false)
RUN_ON_STARTUP=false

# Random Delay (in hours, e.g. 3.5 or 4)
# If set, waits a random amount between 0 and DELAY_MAX_H hours before actually running
# E.g. with DELAY_MAX_H=4 and cron scheduled for 11:00, execution will happen randomly between 11:00 and 15:00
DELAY_MAX_H=

# Optional: Custom birthday wishes
# Can be a JSON string like:
# FB_WISHES={"anyone":["Happy birthday! 🥳🎈","Best wishes!"],"John Doe":["Happy birthday buddy! 🎉"]}
# Or a comma-separated list like:
# FB_WISHES=Happy birthday! 🥳,Have a fantastic day! 🎂,Best wishes! 🎈
FB_WISHES=

# Session persistence (keeps cookies & browser storage across restarts to avoid 2FA triggers)
# Default: true
FB_PERSISTENT=true

# Optional: Bearer token to protect POST /trigger endpoint
TRIGGER_TOKEN=

# Debug mode (verbose logs and delays)
DEBUG=false

# Port for HTTP status & healthcheck endpoint (default: 3000)
PORT=3000
